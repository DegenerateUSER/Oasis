  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary-light",
      "description": "The existing filled execution/new-evaluation action; theme variables remain live.",
      "html": "<button class=\"ds-primary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>New evaluation</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;min-height:36px;padding:.5rem .85rem;border-radius:7px;font:550 1rem/1.25 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;cursor:pointer;transition:background 150ms ease,color 150ms ease;border:1px solid transparent;background:var(--button,#1c5f99);color:var(--button-text,#fff)}.ds-primary:hover{filter:brightness(.94)}.ds-primary:active{filter:brightness(.93)}.ds-primary:focus-visible{outline:3px solid var(--accent,#155b9a);outline-offset:3px}"
    },
    {
      "name": "Secondary control",
      "kind": "button",
      "refersTo": "button-secondary-light",
      "description": "Low-emphasis action used by preview, imports and exports.",
      "html": "<button class=\"ds-secondary\">Read-only preview</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;min-height:36px;padding:.5rem .85rem;border-radius:7px;font:550 1rem/1.25 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;cursor:pointer;transition:background 150ms ease,color 150ms ease;border:1px solid var(--line,#d5dfe9);background:var(--layer,#edf2f8);color:var(--fg,#1c2c42)}.ds-secondary:hover{background:var(--hover,#e5edf7)}.ds-secondary:active{filter:brightness(.93)}.ds-secondary:focus-visible{outline:3px solid var(--accent,#155b9a);outline-offset:3px}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "input-light",
      "description": "Explicit label, quiet surface and boundary, project-colored caret/focus.",
      "html": "<label class=\"ds-field\">Local repository path<input placeholder=\"/absolute/path/to/repository\" /></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:.4rem;font:550 .8rem/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:var(--muted,#53657a)}.ds-field input{min-height:38px;padding:.5rem .7rem;border:1px solid var(--line,#d5dfe9);border-radius:6px;background:var(--surface,#fff);color:var(--fg,#1c2c42);caret-color:var(--accent,#155b9a);font:inherit}.ds-field input::placeholder{color:var(--subtle,#65788f)}.ds-field input:focus-visible{outline:3px solid var(--accent,#155b9a);outline-offset:3px}"
    },
    {
      "name": "Current navigation",
      "kind": "nav",
      "refersTo": "navigation-active-light",
      "description": "An accent underline identifies the current view without a surrounding card.",
      "html": "<nav class=\"ds-nav\"><button aria-current=\"page\">Overview</button><button>Runs</button></nav>",
      "css": ".ds-nav{display:flex;gap:1.4rem}.ds-nav button{position:relative;padding:.8rem .15rem;border:0;background:transparent;color:var(--muted,#53657a);font:500 .9rem/1.25 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;cursor:pointer}.ds-nav button:hover{color:var(--fg,#1c2c42)}.ds-nav [aria-current=page]{color:var(--accent,#155b9a)}.ds-nav [aria-current=page]:after{content:\"\";position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--accent,#155b9a)}.ds-nav button:focus-visible{outline:3px solid var(--accent,#155b9a);outline-offset:3px}"
    },
    {
      "name": "Verified provenance",
      "kind": "chip",
      "description": "A provenance label, not a decorative generic success chip.",
      "html": "<span class=\"ds-provenance\">Verified local run</span>",
      "css": ".ds-provenance{display:inline-flex;align-items:center;gap:.4rem;padding:.3rem .55rem;border-radius:5px;font:.76rem/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:var(--assert,#16744f);background:color-mix(in srgb,var(--assert,#16744f) 12%,transparent)}"
    },
    {
      "name": "Warning notice",
      "kind": "custom",
      "description": "Cautionary provenance or execution information, distinct from an error.",
      "html": "<section class=\"ds-warning\"><strong>Historical · unrevalidated</strong><p>Imported evidence is not a new verified evaluation.</p></section>",
      "css": ".ds-warning{padding:1rem;border-radius:8px;background:var(--warning-bg,#fff5df);color:var(--warning-text,#775117);font:.82rem/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-warning p{margin:.3rem 0 0;max-width:75ch}"
    },
    {
      "name": "Filter container",
      "kind": "card",
      "description": "Observed low-emphasis filter surface; not a reusable metric-card grid.",
      "html": "<section class=\"ds-filters\" aria-label=\"Filters\"><label>Outcome<select><option>All outcomes</option></select></label></section>",
      "css": ".ds-filters{display:flex;gap:.65rem;padding:1rem;border:1px solid var(--line,#d5dfe9);border-radius:9px;background:var(--surface,#fff);color:var(--fg,#1c2c42);font:.8rem/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-filters label{display:grid;gap:.4rem;color:var(--muted,#53657a)}.ds-filters select{min-height:38px;padding:.5rem .7rem;border:1px solid var(--line,#d5dfe9);border-radius:6px;background:var(--surface,#fff);color:var(--fg,#1c2c42);font:inherit}.ds-filters select:focus-visible{outline:3px solid var(--accent,#155b9a);outline-offset:3px}"
    },
    {
      "name": "Narrow outcome control",
      "kind": "button",
      "refersTo": "outcome-selected-light",
      "description": "Illustrative empty-count component state, not an experiment result. Native labels stay separate from data geometry.",
      "html": "<button class=\"ds-outcome\" aria-pressed=\"true\"><span>Survived<b>—</b></span><i aria-hidden=\"true\"></i></button>",
      "css": ".ds-outcome{display:grid;grid-template-columns:minmax(0,1fr);gap:.6rem;min-height:62px;width:100%;padding:.7rem .8rem;border:1px solid var(--accent,#155b9a);border-radius:7px;background:var(--accent-bg,#dceeff);color:var(--fg,#1c2c42);font:550 1rem/1.25 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;cursor:pointer}.ds-outcome>span{display:flex;justify-content:space-between;gap:1rem}.ds-outcome b{font-size:1.1rem;font-variant-numeric:tabular-nums}.ds-outcome>i{height:7px;background:var(--layer,#edf2f8);border-radius:2px}.ds-outcome:hover{background:var(--hover,#e5edf7)}.ds-outcome:active{filter:brightness(.93)}.ds-outcome:focus-visible{outline:3px solid var(--accent,#155b9a);outline-offset:3px}"
    },
    {
      "name": "Run state",
      "kind": "chip",
      "description": "Text and a small semantic dot; this sample is a component state, not a live job.",
      "html": "<span class=\"ds-status\"><i aria-hidden=\"true\"></i>Completed</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:.4rem;color:var(--assert,#16744f);font:.75rem/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-status i{width:6px;height:6px;border-radius:50%;background:currentColor}"
    }
  ],
  "narrative": {
    "northStar": "Signal",
    "overview": "Signal is a restrained operational workspace: a clear reading of mutation evidence, not a decorative dashboard. The light and dark themes preserve identical information hierarchy and semantic roles. Familiar system typography and compact native controls keep attention on source changes, execution boundaries and results.\n\nThe visual system is extracted from the built interface, not a new direction. Palette primitives above are normative observations from `frontend/src/styles.css`; component examples in `.impeccable/design.json` extend them. Derived color ramps in the sidecar are preview aids, not additional shipping CSS tokens.",
    "keyCharacteristics": [
      "Broad analytics sections rather than a wall of interchangeable cards.",
      "Stable outcome colors, with text labels and counts alongside geometry.",
      "Visible provenance, exclusions and unavailable measurements.",
      "Familiar controls, inspectable monospaced evidence and restrained borders.",
      "Equivalent semantic hierarchy in light and dark modes."
    ],
    "rules": [
      {
        "name": "The Same Meaning Rule",
        "body": "Theme changes alter contrast and atmosphere, never the meaning assigned to a result or control.",
        "section": "colors"
      },
      {
        "name": "The Readable Evidence Rule",
        "body": "Do not scale a desktop SVG's text into a miniature mobile chart. Narrow outcome controls use actual HTML labels at the base reading size, with independently sized geometry.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve identical semantic color roles across both themes.",
      "Do place labels and exact counts beside proportional geometry.",
      "Do show provenance, exclusions and unavailable measurements explicitly.",
      "Do keep visible keyboard focus, responsive containment and readable narrow controls.",
      "Do reserve monospace for exact identifiers and evidence."
    ],
    "donts": [
      "Don't replace the broad analytics composition with a generic card wall.",
      "Don't turn unknown data into zero, a trend or a coverage claim.",
      "Don't shrink desktop chart lettering to fit a phone.",
      "Don't use decorative glass, gradients, texture or shadows as evidence hierarchy.",
      "Don't imply that a request, preview or historical import is completed verified execution."
    ]
  }
}
